# Paste an approved affiliate link template for each retailer. {url} is replaced
# with the encoded product page. Without a template, links go to the plain retailer page.
AFFILIATE_TEMPLATE_NIKE=
AFFILIATE_TEMPLATE_ASICS=
AFFILIATE_TEMPLATE_THORLO=

# Optional. Defaults to ./data/app.db
DATABASE_PATH=

# Required in production. Public address of this site, used in email links.
APP_URL=

# Required in production for confirming email and resetting passwords. MAIL_API_URL
# receives a JSON POST of { from, to, subject, text } with a Bearer MAIL_API_KEY.
MAIL_API_URL=
MAIL_API_KEY=
MAIL_FROM=

# Which header holds the visitor's address, for login and signup limits.
# Defaults to x-real-ip on Railway and x-forwarded-for elsewhere.
CLIENT_IP_HEADER=

# Only used with x-forwarded-for: how many trusted proxies sit in front of the app.
TRUSTED_PROXY_HOPS=1
